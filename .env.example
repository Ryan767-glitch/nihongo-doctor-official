ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=info@nihongo-doctor.com
ZOHO_SMTP_PASS=replace-with-zoho-app-password
CONTACT_TO_EMAIL=info@nihongo-doctor.com

# --- A8.net など提携後のアフィリエイトリンク（任意） ---
# 提携審査が通ったら、管理画面で発行した「アフィリエイトリンク」をそのまま貼る。
# 未設定の項目はサイト上に表示されない（空カードは出さない）。
# 第三者の広告タグ／スクリプトは使わず、単純な <a href> のみ。CSP を壊さない。
#
# 例: 海外eSIM（ZEUS WiFi / Glocal eSIM など A8 案件）
NEXT_PUBLIC_AFFILIATE_ESIM_URL=
# NEXT_PUBLIC_AFFILIATE_ESIM_LABEL=海外eSIM
#
# 例: グローバルWiFi / ポケットWiFi
NEXT_PUBLIC_AFFILIATE_WIFI_URL=
# NEXT_PUBLIC_AFFILIATE_WIFI_LABEL=海外WiFi
